+#[derive(Serialize)]
+enum WindmillContentType {
+    RawText,
+    Csv,
+    Parquet,
+    Unknown,
+}
+
+#[derive(Serialize)]
+struct LoadFilePreviewResponse {
+    content: Option<String>,
+    content_type: WindmillContentType,
+    msg: Option<String>,
+}
+
+const TEXT_EXTENSIONS: &[&str] = &[
+    ".json", ".yaml", ".yml", ".xml", ".txt", ".log", ".md", ".html", ".htm", ".js", ".ts",
+    ".py", ".sql", ".sh", ".toml", ".ini", ".env", ".jsonl", ".ndjson", ".svg", ".rs", ".go",
+];
+
+async fn load_file_preview(
+    authed: ApiAuthed,
+    Extension(db): Extension<DB>,
+    Extension(user_db): Extension<UserDB>,
+    Path(w_id): Path<String>,
+    Query(query): Query<LoadFilePreviewQuery>,
+) -> JsonResult<LoadFilePreviewResponse> {
+    let length = query.read_bytes_length.unwrap_or(DEFAULT_PREVIEW_BYTES);
+    if length > MAX_PREVIEW_BYTES {
+        return Err(Error::BadRequest(
+            "Cannot load a preview bigger than 8MB".to_string(),
+        ));
+    }
+    let db_with_opt_authed = DbWithOptAuthed::from_authed(&authed, db.clone(), Some(user_db));
+    let resource = resource_for_request(
+        &db_with_opt_authed,
+        &w_id,
+        None,
+        None,
+        query.storage,
+        &[(&query.file_key, S3Permission::READ)],
+    )
+    .await?;
+    let client = build_object_store_client(&resource).await?;
+
+    let lower = query.file_key.to_lowercase();
+    let content_type = if lower.ends_with(".csv") || lower.ends_with(".tsv") {
+        WindmillContentType::Csv
+    } else if lower.ends_with(".parquet") {
+        WindmillContentType::Parquet
+    } else if TEXT_EXTENSIONS.iter().any(|e| lower.ends_with(e)) {
+        WindmillContentType::RawText
+    } else {
+        WindmillContentType::Unknown
+    };
+
+    let preview: error::Result<String> = match content_type {
+        WindmillContentType::Csv | WindmillContentType::RawText => {
+            let from = query.read_bytes_from.unwrap_or(0);
+            let size = match query.file_size_in_bytes {
+                Some(s) => s,
+                None => {
+                    client
+                        .head(&obj_path(&query.file_key))
+                        .await
+                        .map_err(os_err("Error loading file preview"))?
+                        .size
+                }
+            };
+            read_text_head(client, &query.file_key, from, length, size).await
+        }
+        WindmillContentType::Parquet => Err(Error::ExecutionErr(
+            "Parquet files are previewed as a table.".to_string(),
+        )),
+        WindmillContentType::Unknown => Err(Error::ExecutionErr(
+            "Preview is not available. Content type is unknown or not supported".to_string(),
+        )),
+    };
+    Ok(Json(match preview {
+        Ok(content) => LoadFilePreviewResponse { content: Some(content), content_type, msg: None },
+        Err(e) => LoadFilePreviewResponse { content: None, content_type, msg: Some(e.to_string()) },
+    }))
+}
+
+async fn read_text_head(
+    client: Arc<dyn ObjectStore>,
+    file_key: &str,
+    from: u64,
+    length: u64,
+    size: u64,
+) -> error::Result<String> {
+    if from >= size || size == 0 {
+        return Ok(String::new());
+    }
+    let end = (from + length).min(size);
+    let bytes = client
+        .get_range(&obj_path(file_key), from..end)
+        .await
+        .map_err(os_err("Error fetching file"))?;
+    Ok(String::from_utf8_lossy(&bytes).into_owned())
+}
