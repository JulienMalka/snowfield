+pub fn get_random_file_name(file_extension: Option<String>) -> String {
+    format!(
+        "windmill_uploads/upload_{}_{}.{}",
+        SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_millis(),
+        rand::random::<u16>(),
+        file_extension.unwrap_or_else(|| "file".to_string())
+    )
+}
