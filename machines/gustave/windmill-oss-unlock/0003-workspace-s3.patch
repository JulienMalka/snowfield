+/// The storage setting of a workspace: the primary one, or the named secondary.
+async fn load_lfs(
+    db: &DB,
+    w_id: &str,
+    storage: Option<&str>,
+) -> error::Result<Option<LargeFileStorage>> {
+    let raw: Option<serde_json::Value> = match storage {
+        Some(storage) => sqlx::query_scalar::<_, Option<serde_json::Value>>(
+            "SELECT large_file_storage->'secondary_storage'->$2 FROM workspace_settings WHERE workspace_id = $1",
+        )
+        .bind(w_id)
+        .bind(storage)
+        .fetch_optional(db)
+        .await?
+        .flatten(),
+        None => sqlx::query_scalar::<_, Option<serde_json::Value>>(
+            "SELECT large_file_storage FROM workspace_settings WHERE workspace_id = $1",
+        )
+        .bind(w_id)
+        .fetch_optional(db)
+        .await?
+        .flatten(),
+    };
+    match raw {
+        None | Some(serde_json::Value::Null) => Ok(None),
+        Some(v) => serde_json::from_value::<LargeFileStorage>(v)
+            .map(Some)
+            .map_err(|e| {
+                tracing::error!("invalid large_file_storage value for workspace {w_id}: {e}");
+                Error::internal_err(
+                    "Could not deserialize the workspace storage setting".to_string(),
+                )
+            }),
+    }
+}
+
+fn lfs_resource_type(lfs: &LargeFileStorage) -> StorageResourceType {
+    match lfs {
+        LargeFileStorage::S3Storage(_) => StorageResourceType::S3,
+        LargeFileStorage::AzureBlobStorage(_) => StorageResourceType::AzureBlob,
+        LargeFileStorage::S3AwsOidc(_) => StorageResourceType::S3AwsOidc,
+        LargeFileStorage::AzureWorkloadIdentity(_) => StorageResourceType::AzureWorkloadIdentity,
+        LargeFileStorage::GoogleCloudStorage(_) => StorageResourceType::GoogleCloudStorage,
+    }
+}
+
+/// Resolve the object store resource behind a storage setting. A public
+/// resource is read with instance rights; otherwise with the caller's rights,
+/// and a caller who cannot read it gets `Ok(None)` (the UI then shows the
+/// storage as restricted) rather than an error.
+async fn resolve_lfs<'c>(
+    db_with_opt_authed: &DbWithOptAuthed<'c, ApiAuthed>,
+    w_id: &str,
+    lfs: &LargeFileStorage,
+) -> error::Result<(Option<bool>, Option<ObjectStoreResource>)> {
+    let public = lfs.is_public_resource();
+    let path = lfs.get_s3_resource_path().trim_start_matches("$res:");
+    let resource_type = lfs_resource_type(lfs);
+    let res = if public {
+        let as_instance = match db_with_opt_authed {
+            DbWithOptAuthed::UserDB { authed, db, .. } => {
+                DbWithOptAuthed::from_authed(*authed, db.clone(), None)
+            }
+            DbWithOptAuthed::DB { db, audit_author } => DbWithOptAuthed::DB {
+                db: db.clone(),
+                audit_author: audit_author.clone(),
+            },
+        };
+        get_s3_resource(&as_instance, w_id, path, Some(resource_type), None).await
+    } else {
+        get_s3_resource(db_with_opt_authed, w_id, path, Some(resource_type), None).await
+    };
+    match res {
+        Ok(r) => Ok((Some(public), Some(r))),
+        Err(Error::NotAuthorized(_)) | Err(Error::PermissionDenied(_)) if !public => {
+            Ok((Some(false), None))
+        }
+        Err(Error::NotFound(_)) if !public => Ok((Some(false), None)),
+        Err(e) => Err(e),
+    }
+}
+
+fn check_lfs_paths(
+    authed: Option<&ApiAuthed>,
+    lfs: &LargeFileStorage,
+    paths: &[(&str, S3Permission)],
+) -> error::Result<()> {
+    let Some(rules) = lfs.get_advanced_permissions() else {
+        return Ok(());
+    };
+    // No authed means the server acts on its own behalf (app on-behalf-of
+    // already resolved to a user, triggers, ...): rules apply to users only.
+    // Handlers must therefore build their DbWithOptAuthed with a UserDB so the
+    // caller is kept.
+    let Some(authed) = authed else {
+        return Ok(());
+    };
+    if authed.is_admin {
+        return Ok(());
+    }
+    check_s3_paths(rules, &authed.username, &authed.groups, &authed.folders, paths)
+}
+
+pub async fn get_workspace_s3_resource_and_check_paths<'c>(
+    db_with_opt_authed: &DbWithOptAuthed<'c, ApiAuthed>,
+    w_id: &str,
+    storage: Option<String>,
+    paths: &[(&str, S3Permission)],
+) -> error::Result<(Option<bool>, Option<ObjectStoreResource>)> {
+    let Some(lfs) = load_lfs(db_with_opt_authed.db(), w_id, storage.as_deref()).await? else {
+        return Ok((None, None));
+    };
+    check_lfs_paths(db_with_opt_authed.authed(), &lfs, paths)?;
+    resolve_lfs(db_with_opt_authed, w_id, &lfs).await
+}
+
+pub async fn get_workspace_s3_resource<'c>(
+    authed: &ApiAuthed,
+    db: &DB,
+    user_db: Option<UserDB>,
+    w_id: &str,
+    storage: Option<String>,
+) -> error::Result<(Option<bool>, Option<ObjectStoreResource>)> {
+    let db_with_opt_authed = DbWithOptAuthed::from_authed(authed, db.clone(), user_db);
+    get_workspace_s3_resource_and_check_paths(&db_with_opt_authed, w_id, storage, &[]).await
+}
+
+/// Read a resource (with `$res:` prefix tolerated) and parse it as an object
+/// store resource of the given type (S3 by default).
+pub async fn get_s3_resource<'c>(
+    db_with_opt_authed: &DbWithOptAuthed<'c, ApiAuthed>,
+    w_id: &str,
+    resource_path: &str,
+    resource_type: Option<StorageResourceType>,
+    job_id: Option<Uuid>,
+) -> error::Result<ObjectStoreResource> {
+    let resource_path = resource_path.trim_start_matches("$res:");
+    let raw = get_resource_value_interpolated_internal(
+        db_with_opt_authed,
+        w_id,
+        resource_path,
+        job_id,
+        None,
+        false,
+    )
+    .await?
+    .ok_or_else(|| Error::NotFound(format!("Resource {resource_path} not found")))?;
+    parse_object_store_resource(&resource_type.unwrap_or(StorageResourceType::S3), raw)
+}
+
+/// Resource for a request: an explicit resource path wins, otherwise the
+/// workspace storage (primary or named secondary) with the permission check.
+async fn resource_for_request<'c>(
+    db_with_opt_authed: &DbWithOptAuthed<'c, ApiAuthed>,
+    w_id: &str,
+    s3_resource_path: Option<&str>,
+    resource_type: Option<StorageResourceType>,
+    storage: Option<String>,
+    paths: &[(&str, S3Permission)],
+) -> error::Result<ObjectStoreResource> {
+    match s3_resource_path {
+        Some(p) if !p.is_empty() => {
+            get_s3_resource(db_with_opt_authed, w_id, p, resource_type, None).await
+        }
+        _ => {
+            let (_, res) =
+                get_workspace_s3_resource_and_check_paths(db_with_opt_authed, w_id, storage, paths)
+                    .await?;
+            res.ok_or_else(|| Error::NotFound(NO_STORAGE.to_string()))
+        }
+    }
+}
+
+fn os_err(ctx: &str) -> impl Fn(object_store::Error) -> Error + '_ {
+    move |e| {
+        tracing::warn!("{ctx}: {e:?}");
+        match e {
+            object_store::Error::NotFound { path, .. } => {
+                Error::NotFound(format!("{ctx}: {path} not found"))
+            }
+            e => Error::internal_err(format!("{ctx}: {e}")),
+        }
+    }
+}
+
+fn obj_path(key: &str) -> object_store::path::Path {
+    object_store::path::Path::from(key)
+}
