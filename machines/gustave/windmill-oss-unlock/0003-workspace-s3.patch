+        .route("/load_file_metadata", get(load_file_metadata))
+        .route("/load_file_preview", get(load_file_preview))
+        .route("/load_parquet_preview/*path", get(load_parquet_preview))
+        .route("/load_csv_preview/*path", get(load_csv_preview))
