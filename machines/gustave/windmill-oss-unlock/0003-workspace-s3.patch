+    Path(w_id): Path<String>,
+    Query(query): Query<ListStoredFilesQuery>,
+) -> JsonResult<ListStoredFilesResponse> {
+    let db_with_opt_authed = DbWithOptAuthed::from_authed(&authed, db.clone(), Some(user_db));
+    let Some(lfs) = load_lfs(&db, &w_id, query.storage.as_deref()).await? else {
+        return Err(Error::NotFound(NO_STORAGE.to_string()));
+    };
+    let (public, resource) = resolve_lfs(&db_with_opt_authed, &w_id, &lfs).await?;
+    let Some(resource) = resource else {
+        if !public.unwrap_or(false) {
+            return Ok(Json(ListStoredFilesResponse {
+                restricted_access: Some(true),
+                windmill_large_files: vec![],
+                next_marker: None,
+            }));
+        }
+        return Err(Error::internal_err(NO_STORAGE.to_string()));
+    };
+    let client = build_object_store_client(&resource).await?;
+
+    let prefix = query
+        .prefix
+        .as_deref()
+        .filter(|p| !p.is_empty())
+        .map(obj_path);
+    let stream = match query.marker.as_deref().filter(|m| !m.is_empty()) {
+        Some(marker) => client.list_with_offset(prefix.as_ref(), &obj_path(marker)),
+        None => client.list(prefix.as_ref()),
+    };
+    let rules = if authed.is_admin {
+        None
+    } else {
+        lfs.get_advanced_permissions()
+    };
+    let max_keys = query.max_keys.max(1);
+    let mut files = vec![];
+    let mut stream = stream.take(max_keys);
+    while let Some(meta) = stream
+        .try_next()
+        .await
+        .map_err(os_err("Error listing files"))?
+    {
+        let key = meta.location.to_string();
+        if let Some(rules) = rules {
+            if !s3_path_allowed(
+                rules,
+                &authed.username,
+                &authed.groups,
+                &authed.folders,
+                &key,
+                S3Permission::LIST,
+            ) {
+                continue;
+            }
+        }
+        files.push(WindmillLargeFile { s3: key });
+    }
+    let next_marker = if files.len() >= max_keys {
+        files.last().map(|f| f.s3.clone())
+    } else {
+        None
+    };
+    Ok(Json(ListStoredFilesResponse {
+        restricted_access: Some(false),
+        windmill_large_files: files,
+        next_marker,
+    }))
+}
