+#[derive(Serialize)]
+struct PolarsClientKwargs {
+    region_name: String,
+}
+
+#[derive(Serialize)]
+struct S3fsArgs {
+    endpoint_url: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    key: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    secret: Option<String>,
+    use_ssl: bool,
+    cache_regions: bool,
+    client_kwargs: PolarsClientKwargs,
+}
+
+#[derive(Serialize)]
+struct PolarsStorageOptions {
+    aws_endpoint_url: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    aws_access_key_id: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    aws_secret_access_key: Option<String>,
+    aws_region: String,
+    aws_allow_http: String,
+}
+
+#[derive(Serialize)]
+struct PolarsConnectionSettingsResponse {
+    s3fs_args: S3fsArgs,
+    storage_options: PolarsStorageOptions,
+}
+
+fn s3fs_args(r: &S3Resource) -> S3fsArgs {
+    S3fsArgs {
+        endpoint_url: render_endpoint(
+            r.endpoint_with_region_fallback(None),
+            r.use_ssl,
+            r.port,
+            r.path_style,
+            r.bucket.clone(),
+        ),
+        key: r.access_key.clone(),
+        secret: r.secret_key.clone(),
+        use_ssl: r.use_ssl,
+        cache_regions: false,
+        client_kwargs: PolarsClientKwargs { region_name: r.region.clone() },
+    }
+}
+
+fn polars_response(r: S3Resource) -> PolarsConnectionSettingsResponse {
+    let s3fs = s3fs_args(&r);
+    PolarsConnectionSettingsResponse {
+        storage_options: PolarsStorageOptions {
+            aws_endpoint_url: s3fs.endpoint_url.clone(),
+            aws_access_key_id: r.access_key,
+            aws_secret_access_key: r.secret_key,
+            aws_region: r.region,
+            aws_allow_http: (!r.use_ssl).to_string(),
+        },
+        s3fs_args: s3fs,
+    }
+}
+
+async fn polars_connection_settings(
+    Path(_w_id): Path<String>,
+    Json(body): Json<S3ResourceBody>,
+) -> JsonResult<S3fsArgs> {
+    Ok(Json(s3fs_args(&body.s3_resource)))
+}
