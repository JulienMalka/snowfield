+async fn load_table_count(
+    authed: ApiAuthed,
+    Extension(db): Extension<DB>,
+    Extension(user_db): Extension<UserDB>,
+    Path((w_id, path)): Path<(String, String)>,
+    Query(query): Query<TablePreviewQuery>,
+) -> JsonResult<TableCountResponse> {
+    let file_key = path.trim_start_matches('/');
+    let csv = file_key.to_lowercase().ends_with(".csv") || file_key.to_lowercase().ends_with(".tsv");
+    let db_with_opt_authed = DbWithOptAuthed::from_authed(&authed, db.clone(), Some(user_db));
+    let resource = resource_for_request(
+        &db_with_opt_authed,
+        &w_id,
+        None,
+        None,
+        query.storage,
+        &[(file_key, S3Permission::READ)],
+    )
+    .await?;
+    let client = build_object_store_client(&resource).await?;
+    let sep = if csv {
+        Some(csv_separator(query.csv_separator.as_deref())?)
+    } else {
+        None
+    };
+    let df = open_table(client, file_key, sep).await?;
+    let df = apply_search(df, query.search_col.as_deref(), query.search_term.as_deref())?;
+    let count = df.count().await.map_err(df_err("Error counting rows"))?;
+    Ok(Json(TableCountResponse { count }))
+}
