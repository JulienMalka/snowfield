+pub async fn upload_file_internal(
+    s3_client: Arc<dyn ObjectStore>,
+    file_key: &str,
+    mut stream: impl Stream<Item = Result<Bytes, io::Error>> + Unpin,
+    options: PutMultipartOpts,
+) -> error::Result<()> {
+    let path = obj_path(file_key);
+    let upload = s3_client
+        .put_multipart_opts(&path, options)
+        .await
+        .map_err(os_err("Error initializing upload"))?;
+    let mut writer = WriteMultipart::new(upload);
+    loop {
+        match stream.try_next().await {
+            Ok(Some(chunk)) => {
+                writer.put(chunk);
+                if let Err(e) = writer.wait_for_capacity(8).await {
+                    let _ = writer.abort().await;
+                    return Err(os_err("Error uploading part")(e));
+                }
+            }
+            Ok(None) => break,
+            Err(e) => {
+                let _ = writer.abort().await;
+                return Err(Error::internal_err(format!("Error reading upload body: {e}")));
+            }
+        }
+    }
+    writer
+        .finish()
+        .await
+        .map_err(os_err("Error finishing upload"))?;
+    Ok(())
+}
+
+pub async fn upload_file_from_req(
+    s3_client: Arc<dyn ObjectStore>,
+    file_key: &str,
+    req: Request,
+    options: PutMultipartOpts,
+) -> error::Result<()> {
+    let stream = req
+        .into_body()
+        .into_data_stream()
+        .map_err(|e| io::Error::new(io::ErrorKind::Other, e));
+    upload_file_internal(s3_client, file_key, stream, options).await
+}
+
+pub async fn read_object_streamable(
+    s3_client: Arc<dyn ObjectStore>,
+    file_key: &str,
+) -> error::Result<Response> {
+    let result = s3_client
+        .get(&obj_path(file_key))
+        .await
+        .map_err(os_err("Error retrieving file"))?;
+    let size = result.meta.size;
+    let attributes = result.attributes.clone();
+    let mut headers = HeaderMap::new();
+    let content_type = attributes
+        .get(&object_store::Attribute::ContentType)
+        .map(|v| v.as_ref().to_string())
+        .unwrap_or_else(|| {
+            mime_guess::from_path(file_key)
+                .first_or_octet_stream()
+                .to_string()
+        });
+    if let Ok(v) = HeaderValue::from_str(&content_type) {
+        headers.insert(header::CONTENT_TYPE, v);
+    }
+    if let Some(cd) = attributes.get(&object_store::Attribute::ContentDisposition) {
+        if let Ok(v) = HeaderValue::from_str(cd.as_ref()) {
+            headers.insert(header::CONTENT_DISPOSITION, v);
+        }
+    }
+    headers.insert(header::CONTENT_LENGTH, HeaderValue::from(size));
+    let body = Body::from_stream(result.into_stream());
+    Ok((StatusCode::OK, headers, body).into_response())
+}
+
+pub async fn download_s3_file_internal(
+    authed: ApiAuthed,
+    db: &DB,
+    user_db: Option<UserDB>,
+    w_id: &str,
+    query: DownloadFileQuery,
+) -> error::Result<Response> {
+    let db_with_opt_authed = DbWithOptAuthed::from_authed(&authed, db.clone(), user_db);
+    let resource = resource_for_request(
+        &db_with_opt_authed,
+        w_id,
+        query.s3_resource_path.as_deref(),
+        None,
+        query.storage,
+        &[(&query.file_key, S3Permission::READ)],
+    )
+    .await?;
+    let client = build_object_store_client(&resource).await?;
+    read_object_streamable(client, &query.file_key).await
+}
+
+pub async fn delete_s3_file_internal(
+    authed: &ApiAuthed,
+    db: &DB,
+    _token: &str,
+    w_id: &str,
+    query: DeleteS3FileQuery,
+) -> error::Result<()> {
+    // A UserDB keeps the caller in the context so the permission rules apply.
+    let db_with_opt_authed =
+        DbWithOptAuthed::from_authed(authed, db.clone(), Some(UserDB::new(db.clone())));
+    let resource = resource_for_request(
+        &db_with_opt_authed,
+        w_id,
+        None,
+        None,
+        query.storage,
+        &[(&query.file_key, S3Permission::DELETE)],
+    )
+    .await?;
+    let client = build_object_store_client(&resource).await?;
+    client
+        .delete(&obj_path(&query.file_key))
+        .await
+        .map_err(os_err("Error deleting file"))
+}
