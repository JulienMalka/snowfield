+
+fn expect_s3(resource: ObjectStoreResource, what: &str) -> error::Result<S3Resource> {
+    match resource {
+        ObjectStoreResource::S3(r) => Ok(r),
+        _ => Err(Error::BadConfig(format!(
+            "{what} only works with an S3 storage, this resource is not an S3 resource"
+        ))),
+    }
+}
