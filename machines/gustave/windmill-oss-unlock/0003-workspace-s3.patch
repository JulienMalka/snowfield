+fn df_err(ctx: &str) -> impl Fn(datafusion::error::DataFusionError) -> Error + '_ {
+    move |e| {
+        tracing::warn!("{ctx}: {e}");
+        Error::ExecutionErr(format!("{ctx}: {e}"))
+    }
+}
+
+fn csv_separator(sep: Option<&str>) -> error::Result<u8> {
+    match sep {
+        None | Some("") => Ok(b','),
+        Some("\\t") => Ok(b'\t'),
+        Some(s) if s.len() == 1 => Ok(s.as_bytes()[0]),
+        Some(_) => Err(Error::BadRequest(
+            "Separator must be a single character".to_string(),
+        )),
+    }
+}
+
+/// Open the object as a datafusion dataframe. The store is registered under a
+/// private URL scheme so any object store client can be used as is.
+async fn open_table(
+    client: Arc<dyn ObjectStore>,
+    file_key: &str,
+    csv_sep: Option<u8>,
+) -> error::Result<datafusion::dataframe::DataFrame> {
+    use datafusion::prelude::{CsvReadOptions, ParquetReadOptions, SessionContext};
+    let ctx = SessionContext::new();
+    let base = url::Url::parse("wmill://store/")
+        .map_err(|e| Error::internal_err(format!("bad object store url: {e}")))?;
+    ctx.register_object_store(&base, client);
+    let location = format!("wmill://store/{}", obj_path(file_key));
+    let df = match csv_sep {
+        Some(sep) => {
+            let opts = CsvReadOptions::new()
+                .delimiter(sep)
+                .has_header(true)
+                .file_extension("");
+            ctx.read_csv(location.as_str(), opts)
+                .await
+                .map_err(df_err("Error reading CSV file"))?
+        }
+        None => {
+            let opts = ParquetReadOptions::default().file_extension("");
+            ctx.read_parquet(location.as_str(), opts)
+                .await
+                .map_err(df_err("Error reading parquet file"))?
+        }
+    };
+    Ok(df)
+}
+
+fn apply_search(
+    df: datafusion::dataframe::DataFrame,
+    search_col: Option<&str>,
+    search_term: Option<&str>,
+) -> error::Result<datafusion::dataframe::DataFrame> {
+    use datafusion::arrow::datatypes::DataType;
+    use datafusion::prelude::{cast, ident, lit};
+    match (search_col, search_term) {
+        (Some(c), Some(t)) if !c.is_empty() && !t.is_empty() => {
+            let escaped = t.replace('\\', "\\\\").replace('%', "\\%").replace('_', "\\_");
+            df.filter(cast(ident(c), DataType::Utf8).ilike(lit(format!("%{escaped}%"))))
+                .map_err(df_err("Error filtering table"))
+        }
+        _ => Ok(df),
+    }
+}
+
+async fn batches_to_json(
+    batches: Vec<datafusion::arrow::array::RecordBatch>,
+) -> error::Result<serde_json::Value> {
+    use datafusion::arrow::json::ArrayWriter;
+    let mut writer = ArrayWriter::new(Vec::new());
+    for batch in &batches {
+        writer
+            .write(batch)
+            .map_err(|e| Error::ExecutionErr(format!("Error encoding rows: {e}")))?;
+    }
+    writer
+        .finish()
+        .map_err(|e| Error::ExecutionErr(format!("Error encoding rows: {e}")))?;
+    let buf = writer.into_inner();
+    if buf.is_empty() {
+        return Ok(serde_json::Value::Array(vec![]));
+    }
+    serde_json::from_slice(&buf)
+        .map_err(|e| Error::ExecutionErr(format!("Error decoding rows: {e}")))
+}
+
+async fn table_preview(
+    authed: ApiAuthed,
+    db: DB,
+    user_db: UserDB,
+    w_id: &str,
+    file_key: &str,
+    query: TablePreviewQuery,
+    csv: bool,
+) -> JsonResult<TablePreviewResponse> {
+    use datafusion::prelude::ident;
+    let db_with_opt_authed = DbWithOptAuthed::from_authed(&authed, db.clone(), Some(user_db));
+    let resource = resource_for_request(
+        &db_with_opt_authed,
+        w_id,
+        None,
+        None,
+        query.storage,
+        &[(file_key, S3Permission::READ)],
+    )
+    .await?;
+    let client = build_object_store_client(&resource).await?;
+    let sep = if csv {
+        Some(csv_separator(query.csv_separator.as_deref())?)
+    } else {
+        None
+    };
+    let df = open_table(client, file_key, sep).await?;
+    let columns: Vec<String> = df
+        .schema()
+        .fields()
+        .iter()
+        .map(|f| f.name().clone())
+        .collect();
+    let mut df = apply_search(df, query.search_col.as_deref(), query.search_term.as_deref())?;
+    if let Some(sort_col) = query.sort_col.as_deref().filter(|c| !c.is_empty()) {
+        df = df
+            .sort(vec![ident(sort_col).sort(!query.sort_desc.unwrap_or(false), true)])
+            .map_err(df_err("Error sorting table"))?;
+    }
+    let limit = query.limit.unwrap_or(100).min(TABLE_PREVIEW_MAX_ROWS);
+    df = df
+        .limit(query.offset.unwrap_or(0), Some(limit))
+        .map_err(df_err("Error paginating table"))?;
+    let batches = df.collect().await.map_err(df_err("Error reading table"))?;
+    let rows = batches_to_json(batches).await?;
+    Ok(Json(TablePreviewResponse { columns, rows }))
+}
+
+async fn load_parquet_preview(
+    authed: ApiAuthed,
+    Extension(db): Extension<DB>,
+    Extension(user_db): Extension<UserDB>,
