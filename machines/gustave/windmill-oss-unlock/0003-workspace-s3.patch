diff --git a/windmill-common/src/job_s3_helpers_impl.rs b/windmill-common/src/job_s3_helpers_impl.rs
new file mode 100644
index 000000000..0250c772a
--- /dev/null
+++ b/windmill-common/src/job_s3_helpers_impl.rs
@@ -0,0 +1,211 @@
+//! Open implementation of the workspace object storage helpers that the stock
+//! open-source build leaves as `todo!()` in `job_s3_helpers_oss.rs`.
+//!
+//! Static-credential S3, Azure Blob and GCS resources are fully supported.
+//! `S3AwsOidc` and `AzureWorkloadIdentity` need Windmill to issue OIDC tokens
+//! for the job, which the open build cannot do, so they return a clear error
+//! instead of panicking.
+
+use crate::error::{self, Error};
+use crate::s3_helpers::{
+    AzureBlobResource, GcsResource, ObjectStoreResource, S3Permission, S3PermissionRule,
+    S3Resource, StorageResourceType,
+};
+
+use super::TokenGenerator;
+
+const OIDC_UNAVAILABLE: &str =
+    "AWS OIDC / Azure Workload Identity object storage needs Windmill-issued OIDC tokens, which are not available in this build. Use a resource with static credentials instead.";
+
+/// Parse the raw JSON value of a resource into an `ObjectStoreResource` for the
+/// given storage type.
+pub fn parse_object_store_resource(
+    resource_type: &StorageResourceType,
+    raw: serde_json::Value,
+) -> error::Result<ObjectStoreResource> {
+    match resource_type {
+        StorageResourceType::S3 => serde_json::from_value::<S3Resource>(raw)
+            .map(ObjectStoreResource::S3)
+            .map_err(|e| Error::internal_err(format!("Error reading S3 resource: {e}"))),
+        StorageResourceType::AzureBlob => serde_json::from_value::<AzureBlobResource>(raw)
+            .map(ObjectStoreResource::Azure)
+            .map_err(|e| Error::internal_err(format!("Error reading Azure Blob resource: {e}"))),
+        StorageResourceType::GoogleCloudStorage => serde_json::from_value::<GcsResource>(raw)
+            .map(ObjectStoreResource::Gcs)
+            .map_err(|e| Error::internal_err(format!("Error reading GCS resource: {e}"))),
+        StorageResourceType::S3AwsOidc | StorageResourceType::AzureWorkloadIdentity => {
+            Err(Error::BadConfig(OIDC_UNAVAILABLE.to_string()))
+        }
+    }
+}
+
+pub async fn get_s3_resource_internal<'c>(
+    resource_type: StorageResourceType,
+    s3_resource_value_raw: serde_json::Value,
+    _gen_token: TokenGenerator<'c>,
+    _db: &crate::DB,
+) -> error::Result<ObjectStoreResource> {
+    parse_object_store_resource(&resource_type, s3_resource_value_raw)
+}
+
+pub async fn gen_token<'c>(
+    generator: &TokenGenerator<'c>,
+    audience: &str,
+    _db: Option<&crate::DB>,
+) -> anyhow::Result<String> {
+    match generator {
+        // The API answers this with the OSS OIDC stub; the error is propagated as is.
+        TokenGenerator::AsClient(client) => client.get_id_token(audience).await,
+        TokenGenerator::AsServerInstance() => Err(anyhow::anyhow!(OIDC_UNAVAILABLE)),
+    }
+}
+
+pub fn oidc_unavailable() -> Error {
+    Error::BadConfig(OIDC_UNAVAILABLE.to_string())
+}
+
+/// Expand the `{username}`, `{group}`, `{folder_read}` and `{folder_write}`
+/// placeholders of a rule pattern for one user. A placeholder with no value
+/// (a user without groups, say) yields no pattern.
+fn expand_pattern(
+    pattern: &str,
+    username: &str,
+    groups: &[String],
+    folders: &[(String, bool, bool)],
+) -> Vec<String> {
+    let mut out = vec![pattern.replace("{username}", username)];
+    let expand = |patterns: Vec<String>, placeholder: &str, values: Vec<&str>| -> Vec<String> {
+        let mut next = vec![];
+        for p in patterns {
+            if p.contains(placeholder) {
+                for v in &values {
+                    next.push(p.replace(placeholder, v));
+                }
+            } else {
+                next.push(p);
+            }
+        }
+        next
+    };
+    out = expand(out, "{group}", groups.iter().map(|g| g.as_str()).collect());
+    out = expand(
+        out,
+        "{folder_read}",
+        folders.iter().map(|(f, _, _)| f.as_str()).collect(),
+    );
+    out = expand(
+        out,
+        "{folder_write}",
+        folders
+            .iter()
+            .filter(|(_, w, _)| *w)
+            .map(|(f, _, _)| f.as_str())
+            .collect(),
+    );
+    out
+}
+
+/// Whether `rules` grant `perm` on `path` for this user. Rules are evaluated in
+/// order and the first pattern matching the path decides; a path matched by no
+/// rule is denied (the default rule set ends with a `**/*` catch-all).
+pub fn s3_path_allowed(
+    rules: &[S3PermissionRule],
+    username: &str,
+    groups: &[String],
+    folders: &[(String, bool, bool)],
+    path: &str,
+    perm: S3Permission,
+) -> bool {
+    let path = path.trim_start_matches('/');
+    for rule in rules {
+        for pattern in expand_pattern(&rule.pattern, username, groups, folders) {
+            let glob = match globset::GlobBuilder::new(&pattern)
+                .literal_separator(true)
+                .build()
+            {
+                Ok(g) => g.compile_matcher(),
+                Err(e) => {
+                    tracing::warn!("invalid S3 permission pattern {pattern:?}: {e}");
+                    continue;
+                }
+            };
+            if glob.is_match(path) {
+                return rule.allow.contains(perm);
+            }
+        }
+    }
+    false
+}
+
+/// Check every `(path, permission)` pair against the rules, returning a
+/// permission error naming the first path that is denied.
+pub fn check_s3_paths(
+    rules: &[S3PermissionRule],
+    username: &str,
+    groups: &[String],
+    folders: &[(String, bool, bool)],
+    paths: &[(&str, S3Permission)],
+) -> error::Result<()> {
+    for (path, perm) in paths {
+        if !s3_path_allowed(rules, username, groups, folders, path, *perm) {
+            // Generic(FORBIDDEN): Error::PermissionDenied is mapped to HTTP 500 by
+            // windmill-common's IntoResponse, which the UI would show as a crash.
+            return Err(Error::Generic(
+                axum::http::StatusCode::FORBIDDEN,
+                format!(
+                    "{} access to {path} is not allowed by the workspace storage permission rules",
+                    perm_name(*perm)
+                ),
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn perm_name(perm: S3Permission) -> &'static str {
+    if perm.contains(S3Permission::DELETE) {
+        "Delete"
+    } else if perm.contains(S3Permission::WRITE) {
+        "Write"
+    } else if perm.contains(S3Permission::LIST) {
+        "List"
+    } else {
+        "Read"
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn rules() -> Vec<S3PermissionRule> {
+        serde_json::from_value(serde_json::json!([
+            { "pattern": "windmill_uploads/*", "allow": "read,write,delete" },
+            { "pattern": "u/{username}/**/*", "allow": "read,write,delete,list" },
+            { "pattern": "g/{group}/**/*", "allow": "read,write,delete,list" },
+            { "pattern": "f/{folder_write}/**/*", "allow": "read,write,delete,list" },
+            { "pattern": "f/{folder_read}/**/*", "allow": "read,list" },
+            { "pattern": "**/*", "allow": "" }
+        ]))
+        .unwrap()
+    }
+
+    #[test]
+    fn default_rules() {
+        let r = rules();
+        let groups = vec!["all".to_string(), "data".to_string()];
+        let folders = vec![("ro".to_string(), false, false), ("rw".to_string(), true, false)];
+        let ok = |p: &str, perm| s3_path_allowed(&r, "alice", &groups, &folders, p, perm);
+        assert!(ok("windmill_uploads/x.csv", S3Permission::WRITE));
+        assert!(!ok("windmill_uploads/x.csv", S3Permission::LIST));
+        assert!(!ok("windmill_uploads/sub/x.csv", S3Permission::READ));
+        assert!(ok("u/alice/a/b.txt", S3Permission::DELETE));
+        assert!(!ok("u/bob/a/b.txt", S3Permission::READ));
+        assert!(ok("g/data/x", S3Permission::WRITE));
+        assert!(!ok("g/other/x", S3Permission::READ));
+        assert!(ok("f/ro/x", S3Permission::READ));
+        assert!(!ok("f/ro/x", S3Permission::WRITE));
+        assert!(ok("f/rw/x", S3Permission::WRITE));
+        assert!(!ok("elsewhere/x", S3Permission::READ));
+    }
+}
