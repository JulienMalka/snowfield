+    /// Return the set of tags applied to any message that lives **exclusively**
+    /// in this account's maildir.
+    ///
+    /// Used by `sync::sync()` to compute the set of tags that may need new
+    /// mailboxes created on the JMAP server. The actual push at
+    /// `remote::update()` is already safe — it only assigns mailbox memberships
+    /// for mailboxes that exist on this principal — so this function's only
+    /// job is to keep mailbox *creation* scoped to the current account.
+    ///
+    /// Notmuch deduplicates by Message-Id and unions tags across all files of
+    /// a deduped message. A list mail received on two principals (same
+    /// Message-Id, two file copies) therefore carries the tags of *both*
+    /// account's mailbox structures on the single notmuch object. Including
+    /// such messages here would cause one account to try to create the other
+    /// account's mailboxes (e.g. dgnum trying to create `Archive/K-Fet/Chefs`
+    /// because the deduped ens copy contributes that tag). Filtering to
+    /// exclusive-residents avoids that smear.
+    ///
+    /// Trade-off: a tag applied *only* to a cross-account-deduped message
+    /// won't trigger mailbox creation on any principal. This matches the
+    /// design intent — cross-account tag propagation is out of scope here
+    /// and should be handled by an explicit allowlist mechanism if needed.
+    pub fn all_tags_in_account(&self) -> Result<HashSet<String>, notmuch::Error> {
+        let query = self.db.create_query(&self.all_mail_query)?;
+        query.set_omit_excluded(Exclude::False);
+        let messages = query.search_messages()?;
+        let mut tags = HashSet::new();
+        for message in messages {
+            let exclusive = message
+                .filenames()
+                .into_iter()
+                .all(|p| p.starts_with(&self.mail_cur_dir));
+            if !exclusive {
+                continue;
+            }
+            for tag in message.tags() {
+                tags.insert(tag);
+            }
+        }
+        Ok(tags)
+    }
